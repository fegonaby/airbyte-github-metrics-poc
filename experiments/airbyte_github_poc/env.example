# Shared GitHub source configuration
GITHUB_PERSONAL_ACCESS_TOKEN=replace-me
AIRBYTE_GITHUB_REPOSITORY=fegonaby/github-analysis
AIRBYTE_GITHUB_START_DATE=2026-01-01T00:00:00Z

# Optional: use this for GitHub Enterprise Server.
# AIRBYTE_GITHUB_API_URL=https://github.company.example

# Optional: override the five-stream capability demo.
# AIRBYTE_GITHUB_STREAMS=repositories,pull_requests,pull_request_stats,reviews,review_comments

# Databricks destination configuration
DATABRICKS_SERVER_HOSTNAME=abc-12345678-wxyz.cloud.databricks.com
DATABRICKS_HTTP_PATH=sql/1.0/warehouses/0000-1111111-abcd90
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=github_airbyte_poc

# Recommended: OAuth machine-to-machine credentials.
DATABRICKS_CLIENT_ID=replace-me
DATABRICKS_CLIENT_SECRET=replace-me

# Alternative to OAuth:
# DATABRICKS_TOKEN=replace-me

# Required acknowledgement before the Databricks connector runs.
AIRBYTE_ACCEPT_DATABRICKS_JDBC_TERMS=false
